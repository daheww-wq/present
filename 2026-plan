<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>2026 액션 플랜</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;600&display=swap');

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg: #ffffff;
  --text-1: #37352f;
  --text-2: #787674;
  --text-3: #b0aca8;
  --hover: rgba(55,53,47,0.06);
  --border: rgba(55,53,47,0.09);

  --purple: #6e62c2; --purple-bg: #f0effe; --purple-light: #ede9fe;
  --teal:   #0a7455; --teal-bg:   #e9f8f1; --teal-light:   #dcfce7;
  --amber:  #a05b1a; --amber-bg:  #fef3e2; --amber-light:  #fef9c3;
  --blue:   #1a5fa0; --blue-bg:   #eaf1fb;
  --red:    #be3535; --red-bg:    #fdecea;
  --gray:   #6b6b6b; --gray-bg:   #f1f1ef;
  --green:  #2d6a1f; --green-bg:  #e9f5e1;
  --pink:   #8b2252; --pink-bg:   #fce8f3;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #191919;
    --text-1: #e3e0d8; --text-2: #9a9589; --text-3: #5a5650;
    --hover: rgba(255,255,255,0.055);
    --border: rgba(255,255,255,0.08);
    --purple: #a89ee8; --purple-bg: #2b2642; --purple-light: #2b2642;
    --teal:   #5ab898; --teal-bg:   #0e2d22; --teal-light:   #0e2d22;
    --amber:  #e0a050; --amber-bg:  #2e1e06; --amber-light:  #2e1e06;
    --blue:   #6aa4d8; --blue-bg:   #0d2236;
    --red:    #e07070; --red-bg:    #300e0e;
    --gray:   #a0a0a0; --gray-bg:   #272724;
    --green:  #80c860; --green-bg:  #0f2208;
    --pink:   #d080a8; --pink-bg:   #2a0c1e;
  }
}

body {
  font-family: 'Noto Sans KR', ui-sans-serif, -apple-system, sans-serif;
  background: var(--bg);
  color: var(--text-1);
  max-width: 780px;
  margin: 0 auto;
  padding: 4rem 3rem 6rem;
  font-size: 15px;
  line-height: 1.65;
}

/* ── PAGE TITLE ── */
.page-icon { font-size: 52px; margin-bottom: 12px; display: block; }
.page-title {
  font-size: 32px; font-weight: 700;
  color: var(--text-1); margin-bottom: 4px; letter-spacing: -0.3px;
}
.page-desc { font-size: 14px; color: var(--text-2); margin-bottom: 2.5rem; }

/* ── DIVIDER ── */
hr { border: none; border-top: 1px solid var(--border); margin: 1.5rem 0; }

/* ── CALLOUT ── */
.callout {
  display: flex; gap: 10px; align-items: flex-start;
  background: var(--gray-bg); border-radius: 6px;
  padding: 12px 14px; margin: 0.5rem 0 1.2rem;
  font-size: 14px; color: var(--text-1); line-height: 1.6;
}
.callout-icon { font-size: 16px; flex-shrink: 0; margin-top: 1px; }
.callout.purple { background: var(--purple-light); }
.callout.teal   { background: var(--teal-light); }
.callout.amber  { background: var(--amber-light); }

/* ── TOGGLE ── */
.toggle { margin: 2px 0; }
.toggle-trigger {
  display: flex; align-items: flex-start; gap: 4px;
  padding: 3px 4px; border-radius: 4px;
  cursor: pointer; user-select: none;
  width: 100%;
  background: none; border: none; text-align: left;
  font-family: inherit; font-size: inherit; color: inherit;
  line-height: 1.65;
}
.toggle-trigger:hover { background: var(--hover); }
.toggle-arrow {
  width: 20px; height: 22px;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; color: var(--text-3); font-size: 11px;
  transition: transform 0.18s ease; margin-top: 1px;
}
.toggle.open .toggle-arrow { transform: rotate(90deg); }
.toggle-label { flex: 1; }
.toggle-content {
  display: none;
  padding-left: 24px;
  margin-top: 1px;
}
.toggle.open .toggle-content { display: block; }

/* ── H STYLES ── */
.h1 { font-size: 20px; font-weight: 700; color: var(--text-1); margin: 1.6rem 0 0.5rem; }
.h2 { font-size: 16px; font-weight: 600; color: var(--text-1); margin: 1.2rem 0 0.4rem; }
.h3 { font-size: 14px; font-weight: 600; color: var(--text-2); margin: 0.8rem 0 0.3rem; text-transform: uppercase; letter-spacing: 0.06em; }

/* ── BULLET ── */
.bullets { margin: 2px 0; }
.bullet {
  display: flex; gap: 8px; align-items: flex-start;
  font-size: 14.5px; color: var(--text-1);
  padding: 2px 4px; border-radius: 4px;
  line-height: 1.6;
}
.bullet:hover { background: var(--hover); }
.bullet-dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--text-3); margin-top: 8px; flex-shrink: 0;
}
.bullet-sq {
  width: 14px; font-size: 13px; color: var(--text-3);
  margin-top: 2px; flex-shrink: 0; text-align: center;
}

/* ── CHIP/TAG ── */
.tag {
  display: inline-flex; align-items: center;
  font-size: 11px; font-weight: 500; padding: 1px 8px;
  border-radius: 20px; white-space: nowrap;
  vertical-align: middle; margin-left: 6px; line-height: 1.6;
}
.tag-red    { background: var(--red-bg);    color: var(--red); }
.tag-amber  { background: var(--amber-bg);  color: var(--amber); }
.tag-purple { background: var(--purple-bg); color: var(--purple); }
.tag-green  { background: var(--green-bg);  color: var(--green); }
.tag-gray   { background: var(--gray-bg);   color: var(--gray); }
.tag-teal   { background: var(--teal-bg);   color: var(--teal); }
.tag-blue   { background: var(--blue-bg);   color: var(--blue); }

/* ── PROPERTY ROW ── */
.prop-list { margin: 0.3rem 0 1rem; }
.prop {
  display: flex; gap: 0; align-items: baseline;
  font-size: 14px; padding: 3px 4px;
  border-radius: 4px; color: var(--text-1);
}
.prop:hover { background: var(--hover); }
.prop-key { min-width: 120px; color: var(--text-2); font-size: 13.5px; }
.prop-val { flex: 1; }

/* ── SIMPLE TABLE ── */
.ntable { width: 100%; border-collapse: collapse; font-size: 13.5px; margin: 0.5rem 0 1rem; }
.ntable th {
  text-align: left; padding: 6px 12px;
  font-size: 11px; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase;
  color: var(--text-2); border-bottom: 1px solid var(--border);
  background: var(--gray-bg);
}
.ntable td { padding: 7px 12px; border-bottom: 1px solid var(--border); color: var(--text-1); vertical-align: top; }
.ntable tr:last-child td { border-bottom: none; }
.ntable tr:hover td { background: var(--hover); }
.strike { text-decoration: line-through; color: var(--red); }
.good   { color: var(--teal); font-weight: 500; }

/* ── BOARD (Q2/Q3 side-by-side) ── */
.board { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 0.5rem 0 0.8rem; }
.board-col { background: var(--gray-bg); border-radius: 8px; padding: 12px 14px; }
.board-head {
  font-size: 12px; font-weight: 600; color: var(--text-2);
  text-transform: uppercase; letter-spacing: 0.06em;
  margin-bottom: 10px; display: flex; align-items: center; gap: 6px;
}
.board-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
.bd-purple { background: var(--purple); }
.bd-teal   { background: var(--teal); }
.bitem {
  display: flex; gap: 7px; align-items: flex-start;
  font-size: 13px; color: var(--text-1);
  padding: 3px 0; border-bottom: 1px solid var(--border); line-height: 1.5;
}
.bitem:last-child { border-bottom: none; }
.bitem-dot { width: 4px; height: 4px; border-radius: 50%; background: var(--text-3); margin-top: 7px; flex-shrink: 0; }

/* ── PHASE CARDS ── */
.phase-row { display: grid; grid-template-columns: repeat(3,1fr); gap: 10px; margin: 0.5rem 0 0.8rem; }
.phase-card { background: var(--gray-bg); border-radius: 8px; padding: 11px 13px; }
.phase-badge { font-size: 11px; font-weight: 600; padding: 1px 8px; border-radius: 20px; display: inline-block; margin-bottom: 5px; }
.phase-name { font-size: 13px; font-weight: 600; color: var(--text-1); margin-bottom: 2px; }
.phase-period { font-size: 11px; color: var(--text-2); margin-bottom: 8px; }
.pitem { font-size: 12.5px; color: var(--text-1); padding: 2px 0; border-bottom: 1px solid var(--border); display: flex; gap: 6px; line-height: 1.5; }
.pitem:last-child { border-bottom: none; }

/* ── POSITIONING ── */
.pos-box { background: var(--purple-light); border-radius: 8px; padding: 16px 18px; margin: 0.5rem 0; }
.pos-main { font-size: 17px; font-weight: 700; color: var(--purple); margin-bottom: 10px; }
.pos-props { display: grid; grid-template-columns: repeat(3,1fr); gap: 10px; }
.pos-item-label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--purple); opacity: 0.7; margin-bottom: 3px; }
.pos-item-val { font-size: 13px; color: var(--text-1); line-height: 1.4; }

@media (max-width: 580px) {
  body { padding: 2rem 1.2rem 4rem; }
  .board, .phase-row, .pos-props { grid-template-columns: 1fr; }
}
</style>
</head>
<body>

<span class="page-icon">📋</span>
<p class="page-title">2026 액션 플랜</p>
<p class="page-desc">이직 1순위 · 자기계발 2순위 · 재정 3순위 · Q2~Q3</p>

